<Window x:Class="BongoRigbyWPF.MainWindow"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BongoRigbyWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="260" Width="200"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        MouseDown="Window_MouseDown"
        Topmost="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BG" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="FG" Color="#ff79c6"/>
        <SolidColorBrush x:Key="TEXT" Color="#f8f8f2"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Container that holds top bar and image with identical width and no gap -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Width="180" HorizontalAlignment="Left" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="220" />
            </Grid.RowDefinitions>

            <!-- Top bar inside container -->
            <Border Grid.Row="0" Background="{StaticResource BG}" Opacity="0.95" MouseDown="Window_MouseDown" CornerRadius="6,6,0,0">
                <Grid>
                    <Button x:Name="CloseButton" Width="28" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource FG}" FontWeight="Bold" Cursor="Hand"
                            Click="CloseButton_Click" Padding="0" Margin="0,0,8,0">✕</Button>
                </Grid>
            </Border>

            <!-- Image area directly under top bar, no space -->
            <Border Grid.Row="1" CornerRadius="4" Background="{StaticResource BG}" Padding="0">
                <Grid>
                    <Image Stretch="UniformToFill" x:Name="CatImage"/>

                    <Border VerticalAlignment="Bottom" Height="40" Background="#241f28" Opacity="0.98" CornerRadius="0,0,4,4">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Score}" Foreground="{StaticResource FG}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentTime}" Foreground="{StaticResource FG}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>