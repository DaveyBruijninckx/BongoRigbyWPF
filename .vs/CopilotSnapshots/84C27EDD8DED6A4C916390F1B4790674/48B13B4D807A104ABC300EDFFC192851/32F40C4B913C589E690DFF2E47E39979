<Window x:Class="BongoRigbyWPF.MainWindow"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BongoRigbyWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="260" Width="200"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        MouseDown="Window_MouseDown"
        Topmost="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BG" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="FG" Color="#ff79c6"/>
        <SolidColorBrush x:Key="TEXT" Color="#f8f8f2"/>
    </Window.Resources>

    <Grid>
        <Grid Margin="0,0,10,0" Width="180" Height="220" >
            <Border CornerRadius="4" Background="{StaticResource BG}" Padding="0">
                <Grid>
                    <!-- Image fills the area -->
                    <Image Stretch="UniformToFill" x:Name="CatImage"/>

                    <!-- Bottom info bar with left and right items -->
                    <Border VerticalAlignment="Bottom" Height="36" Background="{StaticResource BG}" Opacity="0.95">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left value -->
                            <TextBlock Text="{Binding Score}" Foreground="{StaticResource FG}" VerticalAlignment="Center" FontSize="12" FontWeight="Semibold"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>