<Window x:Class="BongoRigbyWPF.MainWindow"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BongoRigbyWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="260" Width="200"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        MouseDown="Window_MouseDown"
        Topmost="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BG" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="FG" Color="#ff79c6"/>
        <SolidColorBrush x:Key="TEXT" Color="#f8f8f2"/>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="0,0,10,0">
            <Image Height="220" Width="180" Source="/Images/rigbyIdle.jpg"/>
            <TextBlock HorizontalAlignment="Left"
                 Opacity="1" Text="Kaas" Height="30" Width="180" Foreground="{StaticResource FG}" Background="{StaticResource BG}"/>
        </StackPanel>
    </Grid>
</Window>